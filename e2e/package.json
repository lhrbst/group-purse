{
  "name": "group-purse-e2e",
  "private": true,
  "version": "1.0.0",
  "description": "Ende-zu-Ende-Tests der Gruppenkasse mit Playwright gegen den vollständigen Stack (PostgreSQL, Backend, Frontend, Fake-KI)",
  "scripts": {
    "build": "node scripts/build.mjs",
    "pretest": "node scripts/build.mjs",
    "test": "playwright test",
    "test:desktop": "playwright test --project=desktop",
    "test:mobile": "playwright test --project=mobile",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "report": "playwright show-report",
    "install:browsers": "playwright install chromium"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2"
  }
}
