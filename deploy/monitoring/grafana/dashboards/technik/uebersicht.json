{
  "uid": "uebersicht",
  "title": "Übersicht",
  "tags": [
    "gruppenkasse",
    "technik"
  ],
  "schemaVersion": 41,
  "version": 1,
  "editable": false,
  "timezone": "browser",
  "refresh": "30s",
