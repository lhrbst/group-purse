{
	# Metriken von Caddy (nur im Docker-Netz erreichbar, nicht veröffentlicht)
	admin :2019
	metrics
}

# Grafana (Dashboards); Anmeldung ist Pflicht, die Registrierung ist aus
{$GRAFANA_DOMAIN} {
	reverse_proxy grafana:3000
	encode gzip
	header {
		-Server
	}
}

{$DOMAIN} {
	# Nur der Health-Check ist öffentlich (für den Uptime-Dienst); Metriken liegen auf dem internen Management-Port
	handle /actuator/health* {
		reverse_proxy app:8081
	}
	handle /actuator/* {
		respond 404
	}
	handle {
		reverse_proxy app:8080
	}
	encode gzip
	request_body {
		max_size 20MB
	}
	header {
		-Server
	}
}
