# Wird von der Pipeline aus GitHub Secrets geschrieben (siehe docs/betrieb.md). Nie einchecken.
DOMAIN=kasse.deinverein.de
GITHUB_REPOSITORY=deinname/group-purse
IMAGE_TAG=latest
DB_PASSWORD=bitte-langes-zufaelliges-passwort

MAIL_FROM=kasse@deinverein.de
SMTP_HOST=smtp.example.org
SMTP_PORT=587
SMTP_USER=kasse@deinverein.de
SMTP_PASSWORD=
SMTP_AUTH=true
SMTP_STARTTLS=true

OPENAI_API_KEY=
RECEIPT_AI_ENABLED=false
RECEIPT_MODEL=gpt-6-luna
RECEIPT_FALLBACK_MODEL=gpt-6.1-sol

# Schlüsselpaar erzeugen: npx web-push generate-vapid-keys
VAPID_PUBLIC=
VAPID_PRIVATE=
VAPID_SUBJECT=mailto:kasse@deinverein.de
