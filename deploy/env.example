# Wird von der Pipeline aus GitHub Secrets geschrieben (siehe docs/betrieb.md). Nie einchecken.
DOMAIN=kasse.deinverein.de
GITHUB_REPOSITORY=deinname/group-purse
IMAGE_TAG=latest
DB_PASSWORD=bitte-langes-zufaelliges-passwort

OPENAI_API_KEY=
RECEIPT_AI_ENABLED=false
RECEIPT_MODEL=gpt-6-luna
RECEIPT_FALLBACK_MODEL=gpt-6.1-sol

# Monitoring (Grafana): Subdomain mit eigenem DNS-A-Record auf dieselbe IP, und ein langes Passwort für den Grafana-Admin
GRAFANA_DOMAIN=grafana.kasse.deinverein.de
GRAFANA_ADMIN_PASSWORD=bitte-langes-zufaelliges-passwort
# Werden von deploy.sh gesetzt (hier nur, damit "docker compose config" ohne Server funktioniert)
COMPOSE_PROFILES=monitoring
PROBE_URL=https://kasse.deinverein.de/actuator/health
GRAFANA_ROOT_URL=https://grafana.kasse.deinverein.de
GRAFANA_COOKIE_SECURE=true
